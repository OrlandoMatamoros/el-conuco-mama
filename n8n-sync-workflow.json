{
  "name": "Sync El Conuco Dashboard",
  "nodes": [
    {
      "name": "Schedule",
      "type": "n8n-nodes-base.cron",
      "position": [250, 300],
      "parameters": {
        "triggerTimes": {
          "item": [{
            "hour": 6,
            "minute": 0
          }]
        }
      }
    },
    {
      "name": "Sync Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "parameters": {
        "url": "https://conuco.tuimpulsalab.com/api/sync/auto",
        "method": "GET"
      }
    },
    {
      "name": "Send Notification",
      "type": "n8n-nodes-base.emailSend",
      "position": [650, 300],
      "parameters": {
        "subject": "Dashboard Sincronizado",
        "text": "El dashboard de El Conuco se actualizó correctamente"
      }
    }
  ]
}
